<?xml version="1.0"?>
<sdf version='1.10'>
  <world name='AppleOrchardWorld'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
          <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"> </plugin>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- CUSTOM PLUGINS -->
    <plugin filename="StemBreakPlugin" name="mobi_plugins::StemBreakPlugin">
      <break_threshold>10</break_threshold>
      <stem_joint_name_prefix>apple_stem_joint</stem_joint_name_prefix>
      <scan_for_new_stem_joints>true</scan_for_new_stem_joints>
      <apple_model_prefix>Apple_</apple_model_prefix>
      <stem_link>apple_stem_link</stem_link>
      <tree_model>ApplePlant_1</tree_model>
      <tree_link>apple_plant_link</tree_link>
    </plugin>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.800000012 0.800000012 0.800000012 1</ambient>
            <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
            <specular>0.800000012 0.800000012 0.800000012 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <include>
      <uri>model://ApplePlant</uri>
      <name>ApplePlant_1</name>
      <pose>-1 0 -0.221946 0 0 1.570796327</pose>
    </include>

    <include>
      <uri>model://Apple</uri>
      <name>Apple_0</name>
      <pose>-1.096130 -0.445226 0.572104 -0.625750 -0.000001 0</pose>
    </include>

    <include>
      <uri>model://Apple</uri>
      <name>Apple_1</name>
      <pose>-0.700618 0.193615 0.487739 0 -0.782251 0.563845</pose>
    </include>

    <include>
      <uri>model://Apple</uri>
      <name>Apple_2</name>
      <pose>-0.852326 0.116601 0.413124 0 0 0.0</pose>
    </include>

    <include>
      <uri>model://Apple</uri>
      <name>Apple_3</name>
      <pose>-0.86071 0.233721 0.675750 0.868257 -0.346050 -0.381119</pose>
    </include>

    <include>
      <uri>model://Apple</uri>
      <name>Apple_4</name>
      <pose>-0.773069 0.232495 0.583370 0.000099 -0.525662 1.639110</pose>
    </include>

    <include>
      <uri>model://Apple</uri>
      <name>Apple_5</name>
      <pose>-0.924279 0.261503 0.697834 0.0 -0.0 -0.0</pose>
    </include>

    <include>
      <uri>model://Apple</uri>
      <name>Apple_6</name>
      <pose>-0.889145 0.471669 0.510234 0.0 -0.0 -0.0</pose>
    </include>

    <include>
      <uri>model://Apple</uri>
      <name>Apple_7</name>
      <pose>-0.704417 -0.068454 0.402718 0.0 -0.0 -0.0</pose>
    </include>

    <include>
      <uri>model://Apple</uri>
      <name>Apple_8</name>
      <pose>-0.678500 -0.183603 0.390340 0.0 -0.0 -0.0</pose>
    </include>

    <include>
      <uri>model://Apple</uri>
      <name>Apple_9</name>
      <pose>-0.845943 -0.160451 0.537163 0.0 -0.0 -0.0</pose>
    </include>

    <include>
      <uri>model://Apple</uri>
      <name>Apple_10</name>
      <pose>-0.722231 -0.212508 0.700984 0.0 -0.0 -0.0</pose>
    </include>

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.10000000000000001 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

  </world>
</sdf>